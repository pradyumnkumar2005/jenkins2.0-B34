pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(installationName: 'sonarqube', credentialsId: 'sonarqube_credential') {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=test-project \
                            -Dsonar.projectName=test-project
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }
        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'sonarqube_credential'
                echo 'QUALITY-PASSED'
                }

                echo  'QUALITY-PASSED'                 
	    }    
        }

        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
