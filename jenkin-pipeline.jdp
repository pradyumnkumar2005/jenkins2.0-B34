pipeline {
    agent any
    stages {
        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }
        stage('BUILD') {
            steps {
                dir('backend') {
                   sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }
        stage('TEST') {
            steps {
                 dir('backend') {
                   sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'   
                   sh '-Dsonar.projectKey=test-project'   
                   sh '-Dsonar.projectName='test-project'   
                } 
                echo 'TEST SUCCESS'
            }
        }
        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
