pipeline {
    agent any
    stages {
        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }
        stage('BUILD') {
            steps {
                echo 'BUILD SUCCESS'
            }
        }
        stage('TEST') {
            steps {
                echo 'TEST SUCCESS'
            }
        }
        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
