pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(installationName: 'sonarqube', credentialsId: 'test-project') {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=test-project \
                            -Dsonar.projectName=test-project
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }
        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'test-project'
                }

                echo  'QUALITY-PASSED'                 
	    }    
        }

        stage('store-artifacts') {
            steps {
                sh 'aws s3 cp backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar  s3://jenkins-test-project/student-app.jar'
                    
                echo 'DEPLOY SUCCESS'
            }
        }
        stage ('RELEASE-PROCCESS') {
	   steps {
	       timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Approval is required. Shall we proceed?, OK : "Approve"'
	   
	       }
	   }
	 }

    }
}
