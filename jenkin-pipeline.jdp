
pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-tokan'
                ) {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=test-project \
                            -Dsonar.projectName=test-project
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }

        stage('QUALITY-GATE') {
            steps {
                timeout(time: 8, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-tokan'
                    )
                }
                echo 'QUALITY-PASSED'
            }
        }

        stage('STORE-ARTIFACTS') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'AWS_ACCESS_KEY_ID',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'AWS_SECRET_ACCESS_KEY',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        export AWS_DEFAULT_REGION=ap-south-1

                        aws sts get-caller-identity

                        aws s3 cp \
                        backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar \
                        s3://jenkins-test-project/student-app.jar
                    '''
                }

                echo 'ARTIFACT UPLOAD SUCCESS'
            }
        }

        stage('RELEASE-PROCCESS') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Approval is required. Shall we proceed?'
                }
            }
        }
    }
}
